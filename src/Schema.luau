for name, fields in table.clone(Schema) do
	for _, field in fields do
		table.freeze(field)
	end
	table.freeze(fields)
	if type(name) == "string" then
		local kindId = (Arena.kindIds :: { [string]: number })[name]
		if kindId then
			Schema[kindId] = fields
		end
	end
end
return table.freeze(Schema)
